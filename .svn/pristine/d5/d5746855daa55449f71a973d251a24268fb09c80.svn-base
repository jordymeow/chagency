.admin-ui-page{background-color:#fff;color:#1e1e1e;display:flex;flex-flow:column;min-height:calc(100vh - 32px);position:relative;z-index:1}.admin-ui-page__header{align-items:center;background:#fff;border-bottom:1px solid #e0e0e0;display:flex;gap:16px;justify-content:space-between;padding:16px 24px;position:sticky;top:32px;z-index:1}.admin-ui-page__header-title-wrapper{flex:1 1 auto;min-width:0}.admin-ui-page__header-title{font-size:20px;font-weight:500;line-height:32px;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.admin-ui-page__header-subtitle{color:#6d6d6d;font-size:13px;line-height:24px;margin:0;padding-block-end:4px}.admin-ui-page__header-actions{align-items:center;display:flex;flex:0 0 auto;gap:12px}.admin-ui-page__content{display:flex;flex-direction:column;flex-grow:1;overflow:auto}.admin-ui-page__content.has-padding{padding:16px 24px}@media (max-width:782px){.admin-ui-page__header{top:46px}}.boot-layout-container{min-height:calc(100vh - 32px)}.chagency-settings-column{box-sizing:border-box;margin:0 auto;max-width:680px;padding:0 0 48px;width:100%}@media (max-width:480px){.chagency-settings-column{padding:0 0 32px}}.chagency-provider-row{border-bottom:1px solid var(--wpds-color-stroke-surface-neutral-weak,#e0e0e0);padding:12px 0}.chagency-providers .chagency-provider-row:last-child{border-bottom:0}.chagency-provider-row__name{display:flex;flex:1 1 auto;flex-direction:column;min-width:0}.chagency-badge{border-radius:10px;display:inline-block;font-size:11px;font-weight:600;line-height:1.6;padding:2px 8px;white-space:nowrap}.chagency-badge--ok{background:#d1f2df;color:#114926}.chagency-badge--warn{background:#fef1d4;color:#674e14}.chagency-placeholders{font-size:13px}.chagency-placeholders summary{color:var(--wpds-color-fg-content-neutral-weak,#6d6d6d);cursor:pointer}.chagency-placeholders ul{color:var(--wpds-color-fg-content-neutral,#1e1e1e);margin:8px 0 0;padding-right:20px}.chagency-placeholders li{margin:4px 0}.chagency-placeholders code{background:var(--wpds-color-bg-surface-neutral,#f8f8f8);border-radius:3px;font-size:12px;padding:1px 4px}.chagency-widget-root{position:relative;z-index:99999}.chagency-widget-launcher{align-items:center;background:linear-gradient(-180deg,color-mix(in srgb,var(--wp-admin-theme-color,#2271b1) 88%,#fff) 0,var(--wp-admin-theme-color,#2271b1) 100%);border:0;border-radius:8px 8px 0 0;bottom:0;box-shadow:0 -2px 10px rgba(0,0,0,.16);color:#fff;cursor:pointer;display:inline-flex;font-family:inherit;font-size:13px;font-weight:500;gap:12px;line-height:1;padding:13px 20px;position:fixed;left:24px;transition:box-shadow .18s ease,filter .18s ease;z-index:99999}.chagency-widget-launcher:hover{box-shadow:0 -4px 14px rgba(0,0,0,.22);filter:brightness(1.08)}.chagency-widget-launcher:focus-visible{outline:2px solid var(--wp-admin-theme-color,#2271b1);outline-offset:3px}.chagency-widget-launcher__dot{animation:chagencyLauncherPulse 2.4s ease-out infinite;background:#7dd892;border-radius:50%;box-shadow:0 0 0 0 rgba(125,216,146,.7);flex-shrink:0;height:8px;width:8px}@keyframes chagencyLauncherPulse{0%{box-shadow:0 0 0 0 rgba(125,216,146,.7)}70%{box-shadow:0 0 0 8px rgba(125,216,146,0)}to{box-shadow:0 0 0 0 rgba(125,216,146,0)}}.chagency-widget-launcher__badge{align-items:center;background:#e84a4a;border-radius:50%;color:#fff;display:inline-flex;font-size:11px;font-weight:700;height:20px;justify-content:center;line-height:1;margin-right:2px;min-width:20px;width:20px}@media (prefers-reduced-motion:reduce){.chagency-widget-launcher__dot{animation:none}}.chagency-widget-panel{animation:chagencySlideUp .18s ease-out;background:#fff;border:1px solid var(--wpds-color-stroke-surface-neutral-weak,#e0e0e0);border-bottom:0;border-radius:12px 12px 0 0;bottom:0;box-shadow:0 -4px 24px rgba(0,0,0,.14);display:flex;flex-direction:column;height:min(560px,calc(100vh - 80px));max-width:calc(100vw - 48px);overflow:hidden;position:fixed;left:24px;transform-origin:bottom left;width:380px;z-index:99999}@keyframes chagencySlideUp{0%{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}.chagency-widget-panel__header{align-items:center;border-bottom:1px solid var(--wpds-color-stroke-surface-neutral-weak,#e0e0e0);display:flex;flex:0 0 auto;justify-content:space-between;padding:12px 16px}.chagency-widget-panel__title{align-items:center;display:inline-flex;font-size:14px;font-weight:600;gap:8px}.chagency-widget-panel__title .chagency-widget-launcher__dot{box-shadow:0 0 0 0 rgba(125,216,146,.7)}.chagency-widget-panel__header-actions{align-items:center;display:flex;gap:6px}.chagency-widget-panel__body{background:var(--wpds-color-bg-surface-neutral,#f8f8f8);display:flex;flex:1 1 auto;flex-direction:column;gap:10px;overflow-y:auto;padding:16px}.chagency-widget-bubble{border-radius:14px;font-size:13px;line-height:1.5;max-width:85%;overflow-wrap:anywhere;padding:10px 12px;white-space:pre-wrap;word-break:break-word}.chagency-widget-bubble--assistant{align-self:flex-start;background:#fff;border:1px solid var(--wpds-color-stroke-surface-neutral-weak,#e0e0e0);border-bottom-right-radius:4px}.chagency-widget-bubble--user{align-self:flex-end;background:var(--wp-admin-theme-color,#2271b1);border-bottom-left-radius:4px;color:#fff}.chagency-widget-bubble--error{background:#fcf0f1;border-color:#f0b7b8;color:#b32d2e;font-style:italic}.chagency-widget-bubble--pending{align-items:center;background:#fff;border:1px solid var(--wpds-color-stroke-surface-neutral-weak,#e0e0e0);color:var(--wpds-color-fg-content-neutral-weak,#6d6d6d);display:inline-flex;gap:8px;padding:12px 14px}.chagency-typing{align-items:center;display:inline-flex;gap:4px;height:10px}.chagency-typing__dot{animation:chagencyTypingBounce 1.2s ease-in-out infinite;background:var(--wpds-color-fg-content-neutral-weak,#6d6d6d);border-radius:50%;height:6px;width:6px}.chagency-typing__dot:nth-child(2){animation-delay:.15s}.chagency-typing__dot:nth-child(3){animation-delay:.3s}@keyframes chagencyTypingBounce{0%,60%,to{opacity:.3;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}@media (prefers-reduced-motion:reduce){.chagency-typing__dot{animation:none;opacity:.6}}.chagency-widget-bubble--assistant blockquote,.chagency-widget-bubble--assistant ol,.chagency-widget-bubble--assistant p,.chagency-widget-bubble--assistant pre,.chagency-widget-bubble--assistant ul{margin:0 0 8px}.chagency-widget-bubble--assistant>:last-child{margin-bottom:0}.chagency-widget-bubble--assistant ol,.chagency-widget-bubble--assistant ul{padding-inline-start:20px}.chagency-widget-bubble--assistant li{margin:2px 0}.chagency-widget-bubble--assistant code{background:var(--wpds-color-bg-surface-neutral,#f8f8f8);border-radius:3px;font-family:Menlo,Consolas,monaco,monospace;font-size:12px;padding:1px 5px}.chagency-widget-bubble--assistant pre{background:var(--wpds-color-bg-surface-neutral,#f8f8f8);border-radius:6px;font-size:12px;overflow-x:auto;padding:8px 10px}.chagency-widget-bubble--assistant pre code{background:transparent;font-size:12px;padding:0}.chagency-widget-bubble--assistant a{color:var(--wp-admin-theme-color,#2271b1);text-decoration:underline}.chagency-widget-bubble--assistant h1,.chagency-widget-bubble--assistant h2,.chagency-widget-bubble--assistant h3,.chagency-widget-bubble--assistant h4{font-size:14px;font-weight:600;line-height:1.3;margin:8px 0 4px}.chagency-widget-bubble--assistant strong{font-weight:600}.chagency-widget-bubble--assistant em{font-style:italic}.chagency-widget-panel__composer{align-items:stretch;border-top:1px solid var(--wpds-color-stroke-surface-neutral-weak,#e0e0e0);display:flex;flex:0 0 auto;gap:8px;padding:10px}.chagency-widget-input{min-width:0}.chagency-widget-input,.chagency-widget-input .components-base-control__field{display:flex;flex:1 1 auto}.chagency-widget-input .components-textarea-control__input{font-size:13px;max-height:120px;resize:none}.chagency-widget-panel__composer .components-button{align-self:stretch;height:40px}.chagency-snackbars{align-items:center;bottom:24px;display:flex;flex-direction:column;gap:8px;right:0;pointer-events:none;position:fixed;left:0;z-index:100000}.chagency-snackbars .components-snackbar{margin:0;max-width:520px;pointer-events:auto}
